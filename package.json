{
  "id": "com.lg.app.signage",
  "version": "0.0.1",
  "app": "com.lg.app.signage",
  "name": "com.lg.app.signage",
  "description": "This repository contains a sample app that used the snsgroup HTML5 Player (version 8) on LG webOS",
  "main": "index.html",
  "devDependencies": {
    "ares-webos-sdk": "^3.0.5",
    "eslint": "^8.0.0",
    "eslint-plugin-html": "^6.0.0",
    "prettier": "^2.0.0",
    "standard": "^14.3.1",
    "cross-env": "^7.0.0"
  },
  
  "scripts": {
    "build": "ares-package ./ -o ./build/",
    "push": "cross-env DEVICE=$DEVICE node_modules/ares-webos-sdk/bin/ares-install.sh --device $DEVICE build/com.lg.app.signage.ipk",
    "start": "cross-env DEVICE=$DEVICE node_modules/ares-webos-sdk/bin/ares-launch.sh --device $DEVICE --app com.lg.app.signage",
    "debug": "cross-env DEVICE=$DEVICE node_modules/ares-webos-sdk/bin/ares-inspect.sh --device $DEVICE --app com.lg.app.signage",
    "stop": "cross-env DEVICE=$DEVICE node_modules/ares-webos-sdk/bin/ares-launch.sh --device $DEVICE --close com.lg.app.signage",
    "connect": "bin/connect",
    "clear": "rm -rf ./build/*",
    "format": "prettier --write '**/*.js'",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"

  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snsgroup/snsgroup-player-webos-demo.git"
  },
  "keywords": [
    "webos",
    "lg"
  ],
  "author": "SNS Group",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/snsgroup/snsgroup-player-webos-demo/issues"
  },
  "homepage": "https://github.com/snsgroup/snsgroup-player-webos-demo#readme"
}
